# Vercel / production backend URL. Set this in your Vercel project settings
# to your deployed backend (e.g. https://stroke-rehab-backend.onrender.com).
# For local development, leave unset or set to /api/v1 — the Vite dev server
# proxies /api and /health to http://localhost:3000 (see vite.config.ts).
VITE_API_BASE_URL=https://your-backend-url.example.com