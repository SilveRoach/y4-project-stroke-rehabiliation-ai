# Used when running the backend directly on the host (npm run dev), against the
# `db` container's port published to localhost (see ../docker-compose.yml).
# Copy to backend/.env (gitignored). Keep values in sync with ../.env for docker
# compose runs — same credentials, different host (localhost vs "db").

DATABASE_URL=postgresql://stroke_rehab:change-me@localhost:5432/stroke_rehab
JWT_SECRET=change-me-too
MEDIA_STORAGE_PATH=/app/media
PORT=3000
